{
  "name": "InvestorKit — Portfolio Analytics",
  "short_name": "InvestorKit",
  "description": "Multi-asset portfolio analytics, backtesting, risk and screening that runs on any device and works offline.",
  "id": "investor-kit",
  "start_url": ".",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#070b12",
  "theme_color": "#0b1220",
  "categories": ["finance", "productivity", "utilities"],
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Backtest a strategy",
      "short_name": "Backtest",
      "url": "./?tab=backtest",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Run a screen",
      "short_name": "Screener",
      "url": "./?tab=screener",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
